{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/registrar-pacote.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "methods": ["GET", "POST", "OPTIONS"],
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/registrar-pacote", 
      "methods": ["GET", "POST", "OPTIONS"],
      "dest": "/api/registrar-pacote.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/webhook.js"
    }
  ]
}
