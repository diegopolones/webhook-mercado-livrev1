{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/check-shipments.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "methods": ["GET", "POST", "OPTIONS"],
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/check-shipments",
      "methods": ["GET", "POST", "OPTIONS"],
      "dest": "/api/check-shipments.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/webhook.js"
    }
  ]
}
