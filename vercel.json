{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/registrar-pacote.js": {
      "maxDuration": 30
    },
    "api/buscar-novos-pacotes.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "methods": ["GET", "POST", "OPTIONS"],
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/registrar-pacote",
      "methods": ["GET", "POST", "OPTIONS"],
      "dest": "/api/registrar-pacote.js"
    },
    {
      "src": "/api/buscar-novos-pacotes",
      "methods": ["GET", "POST", "OPTIONS"],
      "dest": "/api/buscar-novos-pacotes.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/webhook.js"
    }
  ]
}
